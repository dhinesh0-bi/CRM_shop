# ─── DATABASE ─────────────────────────────────────────────
# Get this from https://console.neon.tech → your project → Connection string
# Make sure to append ?sslmode=require at the end
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# ─── RAZORPAY ─────────────────────────────────────────────
# https://dashboard.razorpay.com → Settings → API Keys
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# ─── TWILIO ───────────────────────────────────────────────
# https://console.twilio.com → Account Info
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# ─── CORS ─────────────────────────────────────────────────
# Your Render frontend URL (no trailing slash)
FRONTEND_URL=https://find-laundry-crm.onrender.com

# ─── SERVER ───────────────────────────────────────────────
PORT=8080
